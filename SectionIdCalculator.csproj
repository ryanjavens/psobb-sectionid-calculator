<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <RootNamespace>SectionIdCalculator</RootNamespace>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
     <!-- Optional: Compresses native binaries directly into the executable -->
    <IncludeNativeLibrariesForSelfExtract>true</IncludeNativeLibrariesForSelfExtract>

    <!-- Optimizations for Linux native binary-->
    <PublishSingleFile>true</PublishSingleFile>
    <SelfContained>true</SelfContained>
    <!-- Trimming disabled: Spectre.Console.Cli relies on reflection to resolve
         command settings types and is not trim-safe. -->
    <PublishTrimmed>false</PublishTrimmed>

    <!-- Embed debug symbols into the binary instead of emitting a separate .pdb -->
    <DebugType>embedded</DebugType>
  </PropertyGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="SectionIdCalculator.Tests" />
  </ItemGroup>

  <ItemGroup>
    <Compile Remove="SectionIdCalculator.Tests/**/*.cs" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Spectre.Console.Cli" Version="0.55.0" />
  </ItemGroup>

</Project>
